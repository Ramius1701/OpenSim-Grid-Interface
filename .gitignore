# Secrets - matches at any depth, not just this directory's own include/,
# since real credentials were found duplicated under os_temp/'s nested
# reference copies too (2026-09-05) and scrubbed from git history.
**/env.php

# Logs
*.log

# This site's own SQLite database (ws_* tables) - runtime data, not source.
# data/db/.htaccess is intentionally NOT ignored - it's part of the setup.
data/db/*.sqlite
data/db/*.sqlite-*

# OS / editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
